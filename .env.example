# Copy to `.env.local` and fill in with your Supabase project credentials.
# The VITE_ prefix exposes them to the frontend build.
# The non-prefixed versions are used by the Python API functions (scraper).
# On Vercel, set all four as Environment Variables.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
